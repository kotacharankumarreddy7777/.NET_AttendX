@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }
<div class="ax-card" style="max-width:520px"><div class="card-h">Change password</div><div class="card-b">
    <form asp-action="ChangePassword" method="post" data-once>
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="mb-3"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" /></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" /><div class="form-text">Minimum 8 characters with upper case, lower case, a digit and a symbol.</div></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" /></div>
        <button class="btn btn-ax" type="submit">Update password</button>
    </form>
</div></div>
