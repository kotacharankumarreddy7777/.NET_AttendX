@model Dictionary<int, List<AttendX.Models.Timetable>>
@inject AttendX.Data.AppDbContext db
@{
    ViewData["Title"] = "HOD Timetable — @ViewBag.ScopeBranch?.Name";
    var branch = ViewBag.ScopeBranch as AttendX.Models.Branch;
    var sections = ViewBag.Sections as List<AttendX.Models.Section> ?? new();
    var semesters = ViewBag.Semesters as List<AttendX.Models.Semester> ?? new();
    var selectedSection = (int?)ViewBag.SelectedSection ?? 0;
    var selectedSemester = (int)ViewBag.SelectedSemester;
    var currentSemester = (int)ViewBag.CurrentSemester;
    var days = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday };
}
<div class="mb-3"><h1 class="page-title">HOD Timetable — @branch?.Name</h1>
    <div class="text-muted small">All branch members' class timetables — Semester @selectedSemester</div></div>

<div class="ax-card mb-3"><div class="card-b">
    <form method="get" class="row g-2 mb-3 align-items-end">
        <div class="col-md-3"><select name="semester" class="form-select">
            @foreach (var s in semesters) { <option value="@s.Number" selected="@(s.Number == selectedSemester)">Sem @s.Number (@s.Type)</option> }</select></div>
        <div class="col-md-3"><select name="sectionId" class="form-select"><option value="">All sections</option>@foreach (var s in sections) { <option value="@s.Id" selected="@(s.Id == selectedSection)">@s.Name</option> }</select></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Filter</button></div>
        <div class="col-md-2"><a class="btn btn-outline-secondary w-100" asp-action="HodTimetable">Clear</a></div>
    </form>
</div></div>

@if (!Model.Any())
{
    <div class="alert alert-info">No timetable slots found for this branch in the current semester.</div>
}
else
{
    @foreach (var faculty in Model.OrderBy(kvp => kvp.Value.First().Faculty!.FullName))
    {
        var fac = faculty.Value.First().Faculty!;
        var facSlots = faculty.Value.OrderBy(s => s.Section!.Name).ThenBy(s => (int)s.Day).ThenBy(s => s.Period).ToList();
        var sectionsInFaculty = facSlots.Select(s => s.Section!.Name).Distinct().OrderBy(n => n).ToList();

        <div class="ax-card mb-3">
            <div class="card-h d-flex justify-content-between align-items-center">
                <span><i class="bi bi-person-badge me-1"></i>@fac.FullName</span>
                <span class="badge bg-secondary">@sectionsInFaculty.Count section@(sectionsInFaculty.Count == 1 ? "" : "s") · @facSlots.Count slot@(facSlots.Count == 1 ? "" : "s")</span>
            </div>
            <div class="card-b">
                <div class="table-responsive"><table class="table table-bordered table-sm tt-grid mb-0">
                    <thead><tr><th>Section</th>@foreach (var d in days) { <th>@d</th> }</tr></thead>
                    <tbody>
                    @foreach (var sec in sectionsInFaculty)
                    {
                        var secSlots = facSlots.Where(s => s.Section!.Name == sec).ToList();
                        <tr><td><b class="mono">@sec</b></td>
                        @foreach (var d in days)
                        {
                            <td>
                            @foreach (var p in secSlots.Where(s => s.Day == d).OrderBy(s => s.Period))
                            {
                                <div class="tt-cell"><b>@p.Subject!.SubjectCode</b><br /><small class="text-muted">@p.StartTime:hh\\:mm-@p.EndTime:hh\\:mm · @p.RoomNo</small></div>
                            }
                            </td>
                        }
                        </tr>
                    }
                    </tbody></table></div>
            </div>
        </div>
    }
}
@section Scripts { <style> .tt-cell { font-size: 0.85rem; margin-bottom: 4px; padding: 4px; border-radius: 4px; background: #eef4ff; border: 1px solid #c7d2fe; } </style> }
