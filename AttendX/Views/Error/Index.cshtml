@model ErrorViewModel
@{ ViewData["Title"] = Model.Title; Layout = "_AuthLayout"; }
<div class="auth-panel text-center">
    <div style="font-size:34px;font-weight:600;color:var(--navy)">@Model.Code</div>
    <h1>@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    @if (Model.HasDetail)
    {
        <p class="text-muted small mt-2">Reference: <code>@Model.Reference</code></p>
    }
    <a class="btn btn-ax" href="/">Back to Home</a>
</div>
