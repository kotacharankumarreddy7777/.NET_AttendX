@model ErrorViewModel
@{ ViewData["Title"] = Model.Title; Layout = "_AuthLayout"; }
<div class="auth-panel text-center"><div style="font-size:34px;font-weight:600;color:var(--navy)">@Model.Code</div><h1 style="margin-top:4px">@Model.Title</h1><p class="text-muted">@Model.Message</p>
@if (Model.HasDetail)
{
    <div class="alert alert-danger text-start mt-3" role="alert">
        <strong>Exact error (@Model.Code)</strong>
        <pre class="mb-0 mt-2 p-2 bg-dark text-white rounded" style="white-space:pre-wrap;word-break:break-word;font-size:12px;line-height:1.5;">@Model.DetailSummary</pre>
        <button class="btn btn-sm btn-outline-dark mt-2" type="button" onclick="navigator.clipboard.writeText(this.previousElementSibling.innerText)">Copy error</button>
    </div>
}
<a class="btn btn-ax" href="/">Back to Home</a></div>
