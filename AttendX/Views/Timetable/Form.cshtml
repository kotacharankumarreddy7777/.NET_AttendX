@model TimetableFormViewModel
@{ ViewData["Title"] = Model.Id == null ? "Add timetable slot" : "Edit timetable slot"; }
<div class="ax-card" style="max-width:760px"><div class="card-h">@ViewData["Title"]</div><div class="card-b">
<form asp-action="Save" method="post" data-once>
    <div asp-validation-summary="All" class="text-danger small"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="BranchId" class="form-label">Branch</label><select asp-for="BranchId" asp-items="Model.Branches" class="form-select"><option value="0">Select branch</option></select></div>
        <div class="col-md-4"><label asp-for="SectionId" class="form-label">Section</label><select asp-for="SectionId" asp-items="Model.Sections" class="form-select"><option value="0">Select section</option></select></div>
        <div class="col-md-4"><label asp-for="Semester" class="form-label"></label><input asp-for="Semester" type="number" min="1" max="8" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Day" class="form-label"></label><select asp-for="Day" class="form-select">@foreach (var d in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday }) { <option value="@((int)d)" selected="@(d == Model.Day)">@d</option> }</select></div>
        <div class="col-md-4"><label asp-for="Period" class="form-label"></label><input asp-for="Period" type="number" min="1" max="12" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="RoomNo" class="form-label"></label><input asp-for="RoomNo" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="ClassType" class="form-label">Class Type</label><select asp-for="ClassType" asp-items="Model.ClassTypes" class="form-select"></select></div>
        <div class="col-md-6"><label asp-for="SubjectId" class="form-label">Subject</label><select asp-for="SubjectId" asp-items="Model.Subjects" class="form-select"><option value="0">Select subject</option></select></div>
        <div class="col-md-6"><label asp-for="FacultyId" class="form-label">Faculty</label><select asp-for="FacultyId" asp-items="Model.Faculty" class="form-select"><option value="0">Select faculty</option></select></div>
        <div class="col-12"><div class="form-check"><input asp-for="AutoMap" class="form-check-input" /><label asp-for="AutoMap" class="form-check-label"></label></div></div>
    </div>
    <div class="form-text mt-2">Start/end times come from Settings &gt; Periods. Faculty and section double-bookings are rejected.</div>
    <div class="mt-3"><button class="btn btn-ax" type="submit">Save slot</button> <a class="btn btn-outline-secondary" asp-action="Index" asp-route-branchId="@Model.BranchId" asp-route-sectionId="@Model.SectionId" asp-route-semester="@Model.Semester">Cancel</a></div>
</form></div></div>
@section Scripts { <script src="~/js/timetable.js" asp-append-version="true"></script> }
