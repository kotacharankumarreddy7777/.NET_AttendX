@model BackupViewModel
@{ ViewData["Title"] = "Backup / Restore"; }
<h1 class="page-title">Database backup &amp; restore</h1>
<div class="ax-card mb-3"><div class="card-b d-flex flex-wrap justify-content-between align-items-center gap-2"><div><b>Master data (Excel)</b><div class="small text-muted">Admin, faculty, students, subjects, timetable, holidays and notices in one Excel file.</div></div><a class="btn btn-ax" asp-action="ExportExcel"><i class="bi bi-file-earmark-excel"></i> Download Master Data (Excel)</a></div></div>
<div class="row g-3">
    <div class="col-lg-6"><div class="ax-card"><div class="card-h">Create backup</div><div class="card-b">
        <p class="small text-muted">Database: <code>@Model.DatabaseName</code><br />Folder: <code>@Model.Folder</code></p>
        <form asp-action="Create" method="post" data-once><button class="btn btn-ax" type="submit"><i class="bi bi-database-down"></i> Backup now</button></form>
    </div></div></div>
    <div class="col-lg-6"><div class="ax-card"><div class="card-h">Restore</div><div class="card-b">
        <div class="alert alert-danger small">Restoring REPLACES all current data with the backup. The file is verified first. Take a fresh backup before restoring.</div>
        <form asp-action="Restore" method="post" data-confirm="Restore the database? All current data will be replaced.">
            <select name="fileName" class="form-select mb-2" required><option value="">Select backup file</option>@foreach (var f in Model.Files) { <option value="@f.FileName">@f.FileName (@(f.SizeBytes / 1024) KB, @f.CreatedAt.ToString("dd MMM HH:mm"))</option> }</select>
            <input name="confirm" class="form-control mb-2" placeholder="Type RESTORE to confirm" autocomplete="off" />
            <button class="btn btn-danger" type="submit">Restore</button>
        </form>
    </div></div></div>
</div>
<div class="ax-card mt-3"><div class="card-h">History</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>When</th><th>Action</th><th>File</th><th>Size</th><th>Status</th><th>By</th><th>Message</th></tr></thead><tbody>
@foreach (var h in Model.History) { <tr><td>@h.At.ToString("dd MMM yy HH:mm")</td><td>@h.Action</td><td>@h.FileName</td><td>@(h.SizeBytes / 1024) KB</td><td><span class="badge @(h.Status == "Success" ? "bg-success" : "bg-danger")">@h.Status</span></td><td>@h.By</td><td class="small">@h.Message</td></tr> }
</tbody></table></div></div>
