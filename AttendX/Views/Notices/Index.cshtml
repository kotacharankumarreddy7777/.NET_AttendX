@model List<Notice>
@{ ViewData["Title"] = "Manage notices"; }
<div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><h1 class="page-title">Manage notices</h1><a class="btn btn-ax" asp-action="Create"><i class="bi bi-plus-lg"></i> New notice</a></div>
<div class="ax-card">
@if (!Model.Any()) { <div class="card-b"><partial name="_EmptyState" model='new EmptyStateModel("no_notices", "No notices", "", "New Notice", Url.Action("Create"))' /></div> }
else {
<div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Published</th><th>Title</th><th>Audience</th><th>Expires</th><th></th></tr></thead><tbody>
@foreach (var n in Model)
{
    <tr><td>@n.PublishedAt.ToString("dd MMM yyyy")</td><td>@if (n.IsPinned) { <i class="bi bi-pin-angle-fill text-warning"></i> } @n.Title</td><td><span class="badge bg-secondary">@n.Audience</span></td><td>@(n.ExpiresAt?.ToString("dd MMM yyyy") ?? "-")</td>
        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@n.Id">Edit</a>
        <form asp-action="Delete" asp-route-id="@n.Id" method="post" class="d-inline" data-confirm="Delete this notice?"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></td></tr>
}
</tbody></table></div> }
</div>
