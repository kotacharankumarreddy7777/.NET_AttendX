@model List<Faculty>
@{ ViewData["Title"] = "Faculty"; var branches = (List<SelectListItem>)ViewBag.Branches; int? bid = ViewBag.BranchId; bool locked = ViewBag.Locked; bool admin = User.IsInRole("Admin"); string status = ViewBag.Status; }
<div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><h1 class="page-title">Faculty</h1>
@if (admin) { <div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Import"><i class="bi bi-upload"></i> Import CSV</a><a class="btn btn-ax" asp-action="Create"><i class="bi bi-plus-lg"></i> New faculty</a></div> }</div>
<form method="get" class="ax-card card-b mb-3 d-flex gap-2 flex-wrap">
    <input name="search" value="@ViewBag.Search" class="form-control w-auto" placeholder="Search name, email, ID" />
    <select name="branchId" class="form-select w-auto" disabled="@locked"><option value="">All departments</option>@foreach (var b in branches) { <option value="@b.Value" selected="@(b.Value == bid?.ToString())">@b.Text</option> }</select>
    @if (locked) { <input type="hidden" name="branchId" value="@bid" /> }
    <select name="status" class="form-select w-auto"><option value="active" selected="@(status == "active")">Active</option><option value="inactive" selected="@(status == "inactive")">Inactive</option><option value="all" selected="@(status == "all")">All</option></select>
    <button class="btn btn-outline-primary" type="submit">Filter</button>
</form>
<div class="ax-card"><div class="table-responsive"><table class="table table-hover mb-0 dt"><thead><tr><th>ID</th><th>Name</th><th>Department</th><th>Designation</th><th>Email</th><th>Phone</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var f in Model)
{
    <tr><td><code>@f.FacultyID</code></td><td>@f.FullName @if (f.IsHOD) { <span class="badge bg-primary">HOD</span> }</td><td>@f.Branch?.Code</td><td>@f.Designation</td><td>@f.Email</td><td>@f.Phone</td>
        <td>@if (f.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td>
        <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-controller="FacultySubject" asp-action="Index" asp-route-facultyId="@f.Id">Subjects</a>
        @if (admin) { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@f.Id">Edit</a>
            <form asp-action="SetActive" asp-route-id="@f.Id" asp-route-active="@(!f.IsActive)" method="post" class="d-inline" data-confirm="@(f.IsActive ? "Deactivate this faculty? Their login will be blocked." : "Activate this faculty?")"><button class="btn btn-sm btn-outline-danger" type="submit">@(f.IsActive ? "Deactivate" : "Activate")</button></form> }</td></tr>
}
</tbody></table></div></div>
