@model FacultyFormViewModel
@{ ViewData["Title"] = Model.Id == null ? "New faculty" : "Edit faculty"; }
<div class="ax-card" style="max-width:760px"><div class="card-h">@ViewData["Title"]</div><div class="card-b">
<form method="post" data-once>
    <div asp-validation-summary="All" class="text-danger small"></div>
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="FacultyID" class="form-label"></label><input asp-for="FacultyID" class="form-control" readonly="@(Model.Id != null)" /></div>
        <div class="col-md-8"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
        <div class="col-md-5"><label asp-for="BranchId" class="form-label">Department (branch)</label><select asp-for="BranchId" asp-items="Model.Branches" class="form-select"><option value="0">Select department</option></select></div>
        <div class="col-md-4"><label asp-for="Designation" class="form-label"></label><select asp-for="Designation" class="form-select">@foreach (var d in FacultyFormViewModel.Designations) { <option value="@d" selected="@(d == Model.Designation)">@d</option> }</select></div>
        <div class="col-md-3 d-flex align-items-end"><div class="form-check"><input asp-for="IsHOD" class="form-check-input" /><label asp-for="IsHOD" class="form-check-label"></label></div></div>
    </div>
    @if (Model.Id == null) { <div class="alert alert-info mt-3 mb-0 small">A login is created automatically (email = username). A random temporary password is shown once after saving; the faculty must change it at first login.</div> }
    <div class="mt-3"><button class="btn btn-ax" type="submit">Save</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form></div></div>
