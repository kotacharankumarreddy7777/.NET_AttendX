@model List<ExamMark>
@{
    ViewData["Title"] = "Manage Exam Marks";
    var canModify = ViewBag.CanModify == true;
}

<div class="container-fluid py-4 px-3 px-md-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h2 class="fw-bold text-dark mb-0">
            <i class="bi bi-pencil-square me-2 text-primary"></i>Manage Exam Marks
            @if (!canModify)
            {
                <span class="badge bg-secondary">View Only</span>
            }
        </h2>
        <span class="text-muted small">@Model.Count records found</span>
    </div>

    <form class="row row-cols-1 row-cols-md-auto g-2 mb-4" method="get">
        <div class="col">
            <select name="examTimetableId" class="form-select rounded-pill">
                <option value="">All Exams</option>
                @foreach (var item in ViewBag.Exams as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                {
                    <option value="@item.Value" selected="@(ViewBag.ExamTimetableId?.ToString() == item.Value)">@item.Text</option>
                }
            </select>
        </div>
        <div class="col">
            <select name="branchId" class="form-select rounded-pill">
                <option value="">All Branches</option>
                @foreach (var item in ViewBag.Branches as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                {
                    <option value="@item.Value" selected="@(ViewBag.BranchId?.ToString() == item.Value)">@item.Text</option>
                }
            </select>
        </div>
        <div class="col">
            <select name="semester" class="form-select rounded-pill">
                <option value="">All Semesters</option>
                @for (int i = 1; i <= 8; i++) { <option value="@i" selected="@(ViewBag.Semester == i)">Sem @i</option> }
            </select>
        </div>
        <div class="col"><button type="submit" class="btn btn-primary rounded-pill">Filter</button></div>
    </form>

    <form method="post" asp-action="UpdateMarks">
        @Html.AntiForgeryToken()
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Subject / Exam</th>
                            <th>Marks (Out of)</th>
                            <th>Remarks</th>
                            <th>Locked (Admin/HOD)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            for (int i = 0; i < Model.Count; i++)
                            {
                                var m = Model[i];
                                <tr>
                                    <td>
                                        <input type="hidden" name="marks[@i].Id" value="@m.Id" />
                                        <div class="fw-semibold">@m.Student?.FullName</div>
                                        <small class="text-muted">@m.Student?.StudentID · @m.Student?.Branch?.Code / Sem @m.ExamTimetable?.Semester</small>
                                    </td>
                                    <td>
                                        <b>@m.ExamTimetable?.Subject?.SubjectCode</b> @m.ExamTimetable?.Subject?.SubjectName
                                        <br><small class="text-muted">@m.ExamTimetable?.ExamType - @m.ExamTimetable?.ExamDate.ToString("dd MMM")</small>
                                    </td>
                                    <td class="text-nowrap">
                                        <input type="number" step="0.1" min="0" name="marks[@i].MarksObtained" value="@m.MarksObtained" class="form-control d-inline-block" style="width: 80px;" @(m.IsLocked && !canModify ? "readonly" : "") />
                                        /
                                        <input type="number" step="0.1" min="1" name="marks[@i].MaxMarks" value="@m.MaxMarks" class="form-control d-inline-block" style="width: 80px;" @(m.IsLocked && !canModify ? "readonly" : "") />
                                    </td>
                                    <td>
                                        <input type="text" name="marks[@i].Remarks" value="@m.Remarks" class="form-control" placeholder="Remarks..." @(m.IsLocked && !canModify ? "readonly" : "") />
                                    </td>
                                    <td>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="marks[@i].IsLocked" value="true" @(m.IsLocked ? "checked" : "") @(!canModify ? "disabled" : "") />
                                            <input type="hidden" name="marks[@i].IsLocked" value="false" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center py-4">No marks found for this filter.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-success rounded-pill px-4" @(Model.Count == 0 ? "disabled" : "")><i class="bi bi-check-lg me-2"></i>Save Marks</button>
            </div>
        </div>
    </form>
</div>
