@model List<ExamTimetable>
@{
    ViewData["Title"] = "Exam Timetable Management";
    var isAdmin = User.IsInRole("Admin");
}
<h1 class="mb-3">Exam Timetable Management</h1>
<div class="ax-card mb-3">
    <div class="card-h">
        <span><i class="bi bi-calendar3-week me-2"></i>All Branch Exams <small class="text-muted">@Model.Count found</small></span>
        @if (isAdmin)
        {
            <button class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>New Exam</button>
        }
    </div>
    <div class="card-b">
        <form class="row row-cols-1 row-cols-md-auto g-2 mb-3" method="get">
            <div class="col"><select name="branchId" class="form-select form-select-sm"><option value="">All Branches</option>@foreach (var item in ViewBag.Branches as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new()) { <option value="@item.Value" selected="@(ViewBag.BranchId?.ToString() == item.Value)">@item.Text</option> }</select></div>
            <div class="col"><select name="semester" class="form-select form-select-sm"><option value="">All Semesters</option>@for (int i = 1; i <= 8; i++) { <option value="@i" selected="@(ViewBag.Semester == i)">Sem @i</option> }</select></div>
            <div class="col"><select name="examType" class="form-select form-select-sm"><option value="">All Types</option><option value="Mid1" selected="@(ViewBag.ExamType as string == "Mid1")">Mid1</option><option value="Mid2" selected="@(ViewBag.ExamType as string == "Mid2")">Mid2</option><option value="Final" selected="@(ViewBag.ExamType as string == "Final")">Final</option></select></div>
            <div class="col"><button type="submit" class="btn btn-primary btn-sm">Filter</button></div>
        </form>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead><tr><th>Date</th><th>Branch / Sem</th><th>Subject</th><th>Faculty</th><th>Type</th><th>Action</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@e.ExamDate.ToString("dd MMM yyyy")</td>
                                <td>@e.Branch?.Code / Sem @e.Semester</td>
                                <td><b>@e.Subject?.SubjectCode</b> @e.Subject?.SubjectName</td>
                                <td>@e.Faculty?.FullName</td>
                                <td><span class="badge @(e.ExamType == "Final" ? "bg-danger" : e.ExamType == "Mid2" ? "bg-warning text-dark" : "bg-info text-dark")">@e.ExamType</span></td>
                                <td><a asp-action="Manage" asp-route-examTimetableId="@e.Id" class="btn btn-sm btn-outline-primary">View Marks</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model='new EmptyStateModel("no_data", "No exam timetables found.", "Exams are auto-generated based on subject mappings.")' />
        }
    </div>
</div>
