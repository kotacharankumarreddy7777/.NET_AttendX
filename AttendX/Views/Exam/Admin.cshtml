@model List<ExamTimetable>
@{
    ViewData["Title"] = "Exam Timetable Management";
}

<div class="container-fluid py-4 px-3 px-md-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-event me-2 text-primary"></i>Exam Timetables</h2>
        <span class="text-muted small">@Model.Count exams found</span>
    </div>

    <form class="row row-cols-1 row-cols-md-auto g-2 mb-4" method="get">
        <div class="col"><select name="semester" class="form-select rounded-pill"><option value="">All Semesters</option>@for (int i = 1; i <= 8; i++) { <option value="@i" selected="@(ViewBag.Semester == i)">@i</option> }</select></div>
        <div class="col"><select name="examType" class="form-select rounded-pill"><option value="">All Types</option><option value="Mid1" selected="@(ViewBag.ExamType as string == "Mid1")">Mid1</option><option value="Mid2" selected="@(ViewBag.ExamType as string == "Mid2")">Mid2</option><option value="Final" selected="@(ViewBag.ExamType as string == "Final")">Final</option></select></div>
        <div class="col"><button type="submit" class="btn btn-primary rounded-pill">Filter</button></div>
    </form>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Branch / Sem</th>
                            <th>Subject</th>
                            <th>Faculty</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td>@e.ExamDate.ToString("dd MMM yyyy")</td>
                                <td>@UiHelpers.Time(e.StartTime) – @UiHelpers.Time(e.EndTime)</td>
                                <td>@e.Branch?.Code / @e.Semester</td>
                                <td>@e.Subject?.SubjectCode</td>
                                <td>@e.Faculty?.FullName</td>
                                <td><span class="badge bg-primary">@e.ExamType</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">No exam timetables found.</div>
    }
</div>
