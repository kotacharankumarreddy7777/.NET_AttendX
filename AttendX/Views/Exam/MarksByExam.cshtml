@model List<ExamTimetable>
@{
    ViewData["Title"] = "Papers - Marks Entry";
    var exam = ViewBag.Exam as Exam;
    bool isHodOrAdmin = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Hod);
    bool isFacultyOnly = !isHodOrAdmin;
}
<div class="mb-3"><h1 class="page-title">@(exam?.Name) - Papers</h1><div class="text-muted small">@exam?.StartDate.ToString("dd MMM yyyy") to @exam?.EndDate.ToString("dd MMM yyyy") - click "Enter Marks" to open a paper.</div></div>
@if (!Model.Any()) { <partial name="_EmptyState" model='new EmptyStateModel("no_data", "No papers", isFacultyOnly ? "No papers assigned to you for this exam." : "No exam timetable generated yet.")' /> }
else {
<div class="ax-card">
    <div class="card-h">Papers (@Model.Count)</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead><tr><th>Date</th><th>Time</th><th>Section</th><th>Subject</th><th>Room</th><th>Faculty</th><th></th></tr></thead>
            <tbody>
            @foreach (var t in Model.OrderBy(x => x.ExamDate).ThenBy(x => x.StartTime))
            {
                <tr>
                    <td>@t.ExamDate.ToString("dd MMM yyyy")</td>
                    <td>@t.StartTime.ToString(@"hh\:mm")-@t.EndTime.ToString(@"hh\:mm")</td>
                    <td>Sem @t.Semester / @(t.Section?.Name)</td>
                    <td><b class="mono">@(t.Subject?.SubjectCode)</b><br /><span class="small text-muted">@(t.Subject?.SubjectName)</span></td>
                    <td>@t.RoomNo</td>
                    <td>@(t.Faculty?.FullName)</td>
                    <td class="text-end"><a class="btn btn-sm btn-ax" asp-action="Marks" asp-route-examTimetableId="@t.Id">Enter Marks</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
}
