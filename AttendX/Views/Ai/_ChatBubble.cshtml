@model List<AiChatMessage>
@{
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("HOD");
    var latest = ViewBag.LatestReport as AiDiagnosticReport;
}

@if (isAdmin && latest != null)
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3 h-100 @(latest.HealthScore < 70 ? "border-warning" : "border-success")">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark"><i class="bi bi-activity me-2 text-success"></i>System Health Score</span>
                        <span class="badge fs-4 rounded-full @(latest.HealthScore < 70 ? "bg-danger" : "bg-success")">@latest.HealthScore</span>
                    </div>
                    <div class="mt-2">
                        <div class="progress" style="height: 8px; border-radius: 4px;">
                            <div class="progress-bar @(latest.HealthScore < 70 ? "bg-danger" : "bg-success") progress-animated-bar" role="progressbar" style="width: @latest.HealthScore%" aria-valuenow="@latest.HealthScore" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <div class="mt-2 small @(latest.HealthScore < 70 ? "text-danger" : "text-success")">
                        @if (latest.HealthScore < 70) { <span>⚠️ Attention needed!</span> } else { <span>✅ System healthy.</span> }
                        <span class="text-muted">Last checked: @(latest.CreatedAt.ToString("dd MMM HH:mm"))</span>
                    </div>
                    <div class="alert alert-info small mt-2 mb-0" style="white-space: pre-wrap; font-size: 0.85rem;">@latest.ReportText</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="chat-messages-list d-flex flex-column gap-2 py-2">
    @foreach (var msg in Model)
    {
        <div class="d-flex flex-column gap-1 mb-2 align-items-end chat-bubble-wrap">
            <div class="chat-bubble-out p-2.5 px-3 rounded-3 text-white shadow-sm" style="max-width: 85%; font-size: 0.9rem; background: var(--navy);">
                <small class="d-block text-white-50 mb-1" style="font-size: 0.65rem;">@msg.SentAt.ToString("HH:mm")</small>
                @msg.MessageText
            </div>
        </div>
    }
</div>
<div id="aiTypingIndicator" class="d-none">
    <div class="d-flex flex-column gap-2 mb-2 align-items-start">
        <div class="chat-bubble-in p-2.5 px-3 rounded-3 bg-white shadow-sm border" style="max-width: 85%; font-size: 0.9rem;">
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>Thinking...
        </div>
    </div>
</div>
