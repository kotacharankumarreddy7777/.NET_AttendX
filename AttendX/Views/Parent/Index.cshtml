@{
    ViewData["Title"] = "Parent Portal";
    var parent = ViewBag.Parent as Parent;
    var student = ViewBag.Student as Student;
    var percent = (decimal)ViewBag.Percent;
    var leaves = ViewBag.Leaves as List<LeaveApplication> ?? new();
    var leaveTypes = ViewBag.LeaveTypes as List<LeaveType> ?? new();
    var marks = ViewBag.Marks as List<ExamMark> ?? new();
    var wardExams = ViewBag.WardExams as List<ExamTimetable> ?? new();
    var regs = ViewBag.WardExamEligibility as Dictionary<int, bool> ?? new();
    bool hallTicketEligible = ViewBag.HallTicketEligible;
    var threshold = 75m;
}
<div class="mb-3"><h1 class="page-title">Parent Portal</h1><div class="text-muted small">Ward: <b>@student?.FullName</b> (@student?.StudentID) — @student?.Branch?.Name / Sem @student?.Semester / @student?.Section?.Name</div></div>

@if (percent < threshold)
{
    <div class="notice-row mb-3" role="alert">Your ward's attendance is <b>@percent%</b> which is below the required <b>@threshold%</b>. Please encourage regular attendance to avoid exam ineligibility.</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="ax-card stat"><div><div class="v pct @(percent >= threshold ? "pct-ok" : "pct-bad")">@percent%</div><div class="l">Ward Attendance</div></div></div></div>
    <div class="col-6 col-md-3"><div class="ax-card stat"><div><div class="v">@student?.Semester</div><div class="l">Semester</div></div></div></div>
    <div class="col-6 col-md-3"><div class="ax-card stat"><div><div class="v">@leaves.Count(l => l.Status == "Pending")</div><div class="l">Leaves Pending</div></div></div></div>
    <div class="col-6 col-md-3"><div class="ax-card stat"><div><div class="v">@marks.Count</div><div class="l">Marks Recorded</div></div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-7"><div class="ax-card h-100"><div class="card-h">Ward's Exam Timetable (Upcoming)</div>
        @if (!wardExams.Any()) { <partial name="_EmptyState" model='new EmptyStateModel("no_data", "No upcoming exams", "Exam timetable will appear here once published.")' view-data='new ViewDataDictionary(ViewData) { { "compact", true } }' /> }
        else {
        <div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Exam</th><th>Date</th><th>Time</th><th>Subject</th><th>Room</th><th>Eligible</th></tr></thead><tbody>
        @foreach (var e in wardExams) {
            var elig = regs.TryGetValue(e.ExamId, out var ev) ? ev : true;
            <tr><td>@e.Exam?.Name</td><td>@e.ExamDate.ToString("dd MMM yyyy")</td><td>@e.StartTime.ToString(@"hh\:mm")-@e.EndTime.ToString(@"hh\:mm")</td><td><b class="mono">@e.Subject?.SubjectCode</b><br /><span class="small text-muted">@e.Subject?.SubjectName</span></td><td>@e.RoomNo</td><td>@if (elig) { <span class="badge bg-success">Yes</span> } else { <span class="badge bg-danger">No</span> }</td></tr>
        }
        </tbody></table></div> }
    </div></div>
    <div class="col-lg-5"><div class="ax-card h-100"><div class="card-h d-flex justify-content-between align-items-center"><span>Hall Ticket (Ward)</span>@if (hallTicketEligible) { <span class="badge bg-success">Eligible</span> } else { <span class="badge bg-danger">Not eligible</span> }</div><div class="card-b">
        @if (hallTicketEligible)
        {
            <p class="small text-muted mb-2">Your ward is attendance-eligible for the upcoming exams. Hall tickets are generated by the college and shared with the student.</p>
            <div class="notice-row">Bring the hall ticket and institute ID to every exam. Report at least 30 minutes before the start time.</div>
        }
        else
        {
            <p class="small text-danger mb-2">Attendance below the 75% threshold for one or more exams. Your ward may not be allowed to sit those papers.</p>
            <div class="notice-row">Contact the class teacher / HOD to discuss attendance recovery.</div>
        }
    </div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-7"><div class="ax-card h-100"><div class="card-h">Exam Results (Recent)</div>
        @if (!marks.Any()) { <partial name="_EmptyState" model='new EmptyStateModel("no_data", "No marks yet", "Marks will appear here after exams are evaluated.")' /> }
        else {
        <div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Exam</th><th>Subject</th><th>Internal</th><th>External</th><th>Total</th><th>Grade</th></tr></thead><tbody>
        @foreach (var m in marks) {
            var tt = m.ExamTimetable;
            var examName = tt?.Exam?.Name ?? "Exam";
            var subj = tt?.Subject?.SubjectCode ?? "-";
            var isExternal = tt?.Exam?.Type == "External";
            <tr><td>@examName</td><td class="mono">@subj</td><td>@m.InternalMark</td><td>@(isExternal ? m.ExternalMark.ToString() : "-")</td><td><b>@m.TotalMark</b></td><td>@(m.Grade ?? "-")</td></tr>
        }
        </tbody></table></div> }
    </div></div>
    <div class="col-lg-5"><div class="ax-card h-100"><div class="card-h">Apply Leave on Behalf</div><div class="card-b">
        <form asp-action="ApplyLeave" method="post" class="row g-2">
            <div class="col-12"><label class="form-label">Leave Type</label><select name="leaveTypeId" class="form-select" required>@foreach (var lt in leaveTypes) { <option value="@lt.Id">@lt.Name (@lt.DefaultDaysAllowed days)</option> }</select></div>
            <div class="col-6"><label class="form-label">From</label><input type="date" name="startDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
            <div class="col-6"><label class="form-label">To</label><input type="date" name="endDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
            <div class="col-12"><label class="form-label">Reason</label><input name="reason" class="form-control" maxlength="500" required /></div>
            <div class="col-12"><button class="btn btn-ax" type="submit">Submit Leave Request</button></div>
        </form>
    </div></div></div>
</div>

<div class="ax-card"><div class="card-h">Leave Applications</div>
    @if (!leaves.Any()) { <partial name="_EmptyState" model='new EmptyStateModel("no_queries", "No leave applications", "")' /> }
    else {
    <div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Type</th><th>From</th><th>To</th><th>Days</th><th>Reason</th><th>Status</th></tr></thead><tbody>
    @foreach (var l in leaves) { <tr><td>@l.LeaveType?.Name</td><td>@l.StartDate.ToString("dd MMM yyyy")</td><td>@l.EndDate.ToString("dd MMM yyyy")</td><td>@l.TotalDays</td><td>@l.Reason</td><td><span class="badge @(l.Status == "Approved" ? "bg-success" : l.Status == "Rejected" ? "bg-danger" : "bg-warning")">@l.Status</span></td></tr> }
    </tbody></table></div> }
</div>
