@model MarkPageViewModel
@{ ViewData["Title"] = "QR attendance"; }
<div class="ax-card mb-3"><div class="card-b d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div><h4 class="mb-0">@Model.SubjectCode - @Model.SubjectName</h4><div class="text-muted">@Model.BranchCode / section @Model.SectionName - Period @Model.Period (@UiHelpers.Time(Model.Start)-@UiHelpers.Time(Model.End)) - @Model.Students.Count students</div></div>
    <a class="btn btn-outline-secondary" asp-action="Mark" asp-route-id="@Model.TimetableId">Manual list</a>
</div></div>
<div id="scanRoot" data-tt="@Model.TimetableId" data-expiry="30" data-location="@Model.LocationRequirement" data-offline="@(Model.OfflineEnabled ? "true" : "false")" data-date="@Model.Date.ToString("yyyy-MM-dd")" class="row g-3">
    <div class="col-lg-6"><div class="ax-card"><div class="card-b">
        <div id="reader" class="mb-3"></div>
        <div class="d-flex gap-2 justify-content-center mb-3"><button class="btn btn-ax" id="startScan" type="button"><i class="bi bi-camera-video"></i> Start camera</button><button class="btn btn-outline-secondary" id="stopScan" type="button">Stop</button></div>
        <div id="scanResult" class="scan-result scan-info">Press "Start camera", then show a student's QR.</div>
        <p class="small text-muted mt-2 mb-0">Works with a laptop webcam or a phone camera (HTTPS or localhost required). The session key rotates automatically; every scan is verified on the server.</p>
    </div></div></div>
    <div class="col-lg-6"><div class="ax-card"><div class="card-h">Scan log <span class="badge bg-success">Marked this session: <span id="scanCount">0</span></span></div><ul class="list-group list-group-flush" id="scanLog"></ul></div></div>
</div>
@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script src="~/js/qr-scanner.js" asp-append-version="true"></script>
}
