@inject IOptions<InstitutionOptions> Inst
@{ var inst = Inst.Value; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14305A" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <title>@ViewData["Title"] - @inst.ShortName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true"></script>
</head>
<body class="auth-body">
<a class="skip-link" href="#main">Skip to content</a>
<header class="auth-header">
    <span class="pt-logo" style="width:40px;height:40px;font-size:20px">@inst.ShortName.Substring(0, 1)</span>
    <div class="pt-brand"><b style="font-size:16px">@inst.Name</b><span style="display:block">@inst.SystemName</span></div>
</header>
<main class="auth-main" id="main">@RenderBody()</main>
<canvas id="bgCanvas" style="position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:-1;pointer-events:auto;"></canvas>
<div class="auth-footer">&copy; @DateTime.Now.Year @inst.Name. All rights reserved.</div>
<div class="toast-area" id="toastArea" aria-live="polite"></div>
<script>
(function(){
  const c = document.getElementById('bgCanvas');
  const ctx = c.getContext('2d');
  let W,H,mouse={x:0,y:0},pts=[]; const N=60,spd=0.6;
  function resize(){ W=c.width=window.innerWidth; H=c.height=window.innerHeight; }
  window.addEventListener('resize', resize); resize();
  window.addEventListener('mousemove', e => { mouse.x=e.clientX; mouse.y=e.clientY; });
  for(let i=0;i<N;i++) pts.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-0.5)*spd,vy:(Math.random()-0.5)*spd,r:Math.random()*2+1});
  function draw(){
    ctx.clearRect(0,0,W,H);
    for(let i=0;i<N;i++){
      let p=pts[i]; p.x+=p.vx; p.y+=p.vy; if(p.x<0||p.x>W) p.vx*=-1; if(p.y<0||p.y>H) p.vy*=-1;
      let dx=p.x-mouse.x, dy=p.y-mouse.y, dist=Math.sqrt(dx*dx+dy*dy);
      if(dist<150){ p.vx+=dx/dist*0.8; p.vy+=dy/dist*0.8; }
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fillStyle='#4dabf7'; ctx.globalAlpha=0.8; ctx.fill(); ctx.globalAlpha=1;
      for(let j=i+1;j<N;j++){
        let q=pts[j], dx=q.x-p.x, dy=q.y-p.y, d=Math.sqrt(dx*dx+dy*dy);
        if(d<120){ ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(q.x,q.y); ctx.strokeStyle='rgba(77,171,247,0.25)'; ctx.stroke(); }
      }
    }
    requestAnimationFrame(draw);
  }
  draw();
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
