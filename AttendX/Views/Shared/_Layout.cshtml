@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject INoticeService NoticeSvc
@inject ISettingsService SettingsSvc
@inject IOptions<InstitutionOptions> Inst
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject AppDbContext Db
@{
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool admin = User.IsInRole("Admin"), hod = User.IsInRole("HOD"), fac = User.IsInRole("Faculty"), student = User.IsInRole("Student");
    bool staff = admin || hod || fac;
    int bell = await NoticeSvc.RecentCountAsync();
    var year = await SettingsSvc.GetCurrentYearAsync();
    string roleText = admin ? "Administrator" : hod ? "Head of Department" : fac ? "Faculty" : "Student";
    var appUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    string rawName = appUser?.FullName ?? User.Identity?.Name ?? "";
    if (rawName.StartsWith("Student ")) rawName = rawName.Substring(8);
    string displayName = rawName;
    string emailDisplay = appUser?.Email ?? "";
    if (student && appUser != null)
    {
        var st = await Db.Students.AsNoTracking().FirstOrDefaultAsync(x => x.IdentityUserId == appUser.Id);
        if (st != null)
        {
            displayName = st.FullName.StartsWith("Student ") ? st.StudentID : st.FullName;
            emailDisplay = AttendX.Infrastructure.EmailHelper.StudentEmail(st.StudentID, st.FullName);
        }
    }
    if (fac && appUser != null)
    {
        var facRec = await Db.Faculty.AsNoTracking().FirstOrDefaultAsync(x => x.IdentityUserId == appUser.Id);
        if (facRec != null)
        {
            emailDisplay = AttendX.Infrastructure.EmailHelper.FacultyEmail(facRec.FacultyID, facRec.FullName);
        }
    }
    if (string.IsNullOrEmpty(emailDisplay)) emailDisplay = roleText;
    // Active nav item: match the controller, and when actions are given, only those actions (so e.g. Attendance/Corrections
    // does not light up "Today's Classes" and Notices/Index does not light up "Notices").
    string A(string c, params string[] actions) =>
        string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) &&
        (actions.Length == 0 || actions.Contains(act, StringComparer.OrdinalIgnoreCase)) ? "active" : "";
    string[] todayActions = ["Index", "Mark", "Scan", "SessionToken", "ScanPost", "Sync"];
    var inst = Inst.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf" content="@token" />
    <meta name="theme-color" content="#14305A" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <title>@ViewData["Title"] - @inst.ShortName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body data-offline="true">
<a class="skip-link" href="#main">Skip to content</a>
<header class="pt-header">
    <button class="pt-menu" id="sbToggle" type="button" aria-label="Menu"><i class="bi bi-list"></i></button>
    <span class="pt-logo">@inst.ShortName.Substring(0, 1)</span>
    <div class="pt-brand"><div class="pt-brand-text"><b>@inst.Name</b><span>@inst.SystemName</span></div></div>
    <div class="pt-right">
        <span id="offlineBadge" class="badge bg-warning d-none"></span>
        <span id="liveTime" class="badge bg-success d-none d-md-inline-block" style="font-size: 11px; padding: 4px 8px;"></span>
        <a class="pt-bell" asp-controller="Notices" asp-action="Board" aria-label="Notices"><i class="bi bi-bell"></i>@if (bell > 0) { <span class="n">@bell</span> }</a>
        <div class="pt-user d-none d-md-block"><b>@displayName</b><span>@emailDisplay</span></div>
        <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" class="m-0"><button class="pt-out" type="submit">Sign out</button></form>
    </div>
</header>
<aside class="pt-side" aria-label="Main menu">
    @if (student)
    {
        <a class="@A("Student", "Index", "Query", "MyQr", "Card", "UpdatePhone")" asp-controller="Student" asp-action="Index" title="Dashboard"><i class="bi bi-speedometer2"></i> <span class="nav-text">Dashboard</span></a>
        <a class="@A("Notices", "Board")" asp-controller="Notices" asp-action="Board" title="Notices"><i class="bi bi-megaphone"></i> <span class="nav-text">Notices</span></a>
        <a class="@A("Student", "Report")" asp-controller="Student" asp-action="Report" title="Attendance Report"><i class="bi bi-file-earmark-pdf"></i> <span class="nav-text">Attendance Report</span></a>
        <a class="@A("Account", "ChangePassword")" asp-controller="Account" asp-action="ChangePassword" title="Change Password"><i class="bi bi-key"></i> <span class="nav-text">Change Password</span></a>
    }
    @if (staff)
    {
        <a class="@A("Dashboard")" asp-controller="Dashboard" asp-action="Index" title="Dashboard"><i class="bi bi-speedometer2"></i> <span class="nav-text">Dashboard</span></a>
        <div class="grp"><span class="nav-text">Attendance</span></div>
        <a class="@A("Attendance", todayActions)" asp-controller="Attendance" asp-action="Index" title="Today's Classes"><i class="bi bi-check2-square"></i> <span class="nav-text">Today's Classes</span></a>
        @if (admin || hod) { <a class="@A("Attendance", "Corrections")" asp-controller="Attendance" asp-action="Corrections" title="Corrections"><i class="bi bi-pencil-square"></i> <span class="nav-text">Corrections</span></a> }
        <a class="@A("Timetable")" asp-controller="Timetable" asp-action="Index" title="Timetable"><i class="bi bi-calendar3-week"></i> <span class="nav-text">Timetable</span></a>
        <a class="@A("Queries")" asp-controller="Queries" asp-action="Index" title="Student Queries"><i class="bi bi-chat-square-text"></i> <span class="nav-text">Student Queries</span></a>
        <div class="grp"><span class="nav-text">Reports</span></div>
        <a class="@A("Reports")" asp-controller="Reports" asp-action="Index" title="Reports"><i class="bi bi-file-earmark-bar-graph"></i> <span class="nav-text">Reports</span></a>
        <a class="@A("Analytics")" asp-controller="Analytics" asp-action="Index" title="Attendance Summary"><i class="bi bi-table"></i> <span class="nav-text">Attendance Summary</span></a>
        <a class="@A("Notices", "Board")" asp-controller="Notices" asp-action="Board" title="Notices"><i class="bi bi-megaphone"></i> <span class="nav-text">Notices</span></a>
    }
    @if (admin || hod)
    {
        <div class="grp"><span class="nav-text">Academic Data</span></div>
        <a class="@A("Students")" asp-controller="Students" asp-action="Index" title="Students"><i class="bi bi-mortarboard"></i> <span class="nav-text">Students</span></a>
        <a class="@A("Faculty")" asp-controller="Faculty" asp-action="Index" title="Faculty"><i class="bi bi-person-workspace"></i> <span class="nav-text">Faculty</span></a>
        <a class="@A("FacultySubject")" asp-controller="FacultySubject" asp-action="Index" title="Faculty - Subject"><i class="bi bi-diagram-3"></i> <span class="nav-text">Faculty - Subject</span></a>
        <a class="@A("Subjects")" asp-controller="Subjects" asp-action="Index" title="Subjects"><i class="bi bi-book"></i> <span class="nav-text">Subjects</span></a>
        <a class="@A("Notices", "Index", "Create", "Edit", "Save", "Delete")" asp-controller="Notices" asp-action="Index" title="Manage Notices"><i class="bi bi-send"></i> <span class="nav-text">Manage Notices</span></a>
    }
    @if (admin)
    {
        <a class="@A("Branches")" asp-controller="Branches" asp-action="Index" title="Branches"><i class="bi bi-building"></i> <span class="nav-text">Branches</span></a>
        <a class="@A("Sections")" asp-controller="Sections" asp-action="Index" title="Sections"><i class="bi bi-grid-3x3-gap"></i> <span class="nav-text">Sections</span></a>
        <a class="@A("Holidays")" asp-controller="Holidays" asp-action="Index" title="Holidays"><i class="bi bi-calendar-event"></i> <span class="nav-text">Holidays</span></a>
    }
    @if (admin || hod)
    {
        <div class="grp"><span class="nav-text">System</span></div>
        <a class="@A("Audit")" asp-controller="Audit" asp-action="Index" title="Audit Log"><i class="bi bi-shield-check"></i> <span class="nav-text">Audit Log</span></a>
    }
    @if (admin)
    {
        <a class="@A("Backup")" asp-controller="Backup" asp-action="Index" title="Backup and Export"><i class="bi bi-database-down"></i> <span class="nav-text">Backup and Export</span></a>
        <a class="@A("Settings")" asp-controller="Settings" asp-action="Index" title="Settings"><i class="bi bi-gear"></i> <span class="nav-text">Settings</span></a>
    }
    @if (staff) { <a class="@A("Account", "ChangePassword")" asp-controller="Account" asp-action="ChangePassword" title="Change Password"><i class="bi bi-key"></i> <span class="nav-text">Change Password</span></a> }
</aside>
<div class="ax-backdrop"></div>
<div class="pt-main">
    <div class="pt-ctx">
        <div class="crumb"><a href="/">Home</a> / <b>@ViewData["Title"]</b></div>
        <div class="info"><span>Academic Year @year.Name</span><span>@DateTime.Now.ToString("dddd, dd MMM yyyy")</span></div>
    </div>
    <main class="pt-content" id="main">
        @if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show" role="status">@ok<button class="btn-close" data-bs-dismiss="alert" type="button" aria-label="Close"></button></div> }
        @if (TempData["Error"] is string er) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@er<button class="btn-close" data-bs-dismiss="alert" type="button" aria-label="Close"></button></div> }
        @if (TempData["TempPassword"] is string tp) { <div class="alert alert-warning alert-dismissible fade show">@tp<button class="btn-close" data-bs-dismiss="alert" type="button" aria-label="Close"></button></div> }
        @RenderBody()
    </main>
    <footer class="pt-footer">&copy; @DateTime.Now.Year @inst.Name. All rights reserved.</footer>
</div>
<nav class="pt-tabbar" aria-label="Quick navigation">
    @if (student)
    {
        <a class="@A("Student", "Index", "Query", "MyQr", "Card", "UpdatePhone")" asp-controller="Student" asp-action="Index"><i class="bi bi-house"></i>Home</a>
        <a class="@A("Notices", "Board")" asp-controller="Notices" asp-action="Board"><i class="bi bi-megaphone"></i>Notices</a>
        <a class="@A("Student", "Report")" asp-controller="Student" asp-action="Report"><i class="bi bi-file-earmark-pdf"></i>Report</a>
    }
    else
    {
        <a class="@A("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-house"></i>Home</a>
        <a class="@A("Attendance", todayActions)" asp-controller="Attendance" asp-action="Index"><i class="bi bi-check2-square"></i>Today</a>
        <a class="@A("Timetable")" asp-controller="Timetable" asp-action="Index"><i class="bi bi-calendar3-week"></i>Timetable</a>
    }
    <a href="#" id="tabMenu"><i class="bi bi-list"></i>Menu</a>
</nav>
<div class="toast-area" id="toastArea" aria-live="polite"></div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/offline-sync.js" asp-append-version="true"></script>
<script src="~/js/live-sync.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
