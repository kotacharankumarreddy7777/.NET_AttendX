@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject INoticeService NoticeSvc
@inject ISettingsService SettingsSvc
@inject IOptions<InstitutionOptions> Inst
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject AppDbContext Db
@{
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool admin = User.IsInRole("Admin"), hod = User.IsInRole("HOD"), fac = User.IsInRole("Faculty"), student = User.IsInRole("Student"), parent = User.IsInRole("Parent");
    bool staff = admin || hod || fac;
    int bell = await NoticeSvc.RecentCountAsync();
    var year = await SettingsSvc.GetCurrentYearAsync();
    string roleText = admin ? "Administrator" : hod ? "Head of Department" : fac ? "Faculty" : parent ? "Parent" : "Student";
    var appUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    string rawName = appUser?.FullName ?? User.Identity?.Name ?? "";
    if (rawName.StartsWith("Student ")) rawName = rawName.Substring(8);
    string displayName = rawName;
    string emailDisplay = appUser?.Email ?? "";
    if (student && appUser != null)
    {
        var st = await Db.Students.AsNoTracking().FirstOrDefaultAsync(x => x.IdentityUserId == appUser.Id);
        if (st != null)
        {
            displayName = st.FullName.StartsWith("Student ") ? st.StudentID : st.FullName;
            emailDisplay = st.Email;
        }
    }
    if (parent && appUser != null)
    {
        var p = await Db.Parents.AsNoTracking().Include(x => x.Student).FirstOrDefaultAsync(x => x.IdentityUserId == appUser.Id);
        if (p?.Student != null)
        {
            displayName = "Parent of " + p.Student.FullName;
            emailDisplay = p.Email;
        }
    }
    if (string.IsNullOrEmpty(emailDisplay)) emailDisplay = roleText;
    // Active nav item: match the controller, and when actions are given, only those actions (so e.g. Attendance/Corrections
    // does not light up "Today's Classes" and Notices/Index does not light up "Notices").
    string A(string c, params string[] actions) =>
        string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) &&
        (actions.Length == 0 || actions.Contains(act, StringComparer.OrdinalIgnoreCase)) ? "active" : "";
    string[] todayActions = ["Index", "Mark", "Scan", "SessionToken", "ScanPost", "Sync"];
    var inst = Inst.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf" content="@token" />
    <meta name="theme-color" content="#14305A" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <title>@ViewData["Title"] - @inst.ShortName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body data-offline="true">
<a class="skip-link" href="#main">Skip to content</a>
<header class="pt-header">
    <button class="pt-menu" id="sbToggle" type="button" aria-label="Menu"><i class="bi bi-list"></i></button>
    <span class="pt-logo">@inst.ShortName.Substring(0, 1)</span>
    <div class="pt-brand"><div class="pt-brand-text"><b>@inst.Name</b><span>@inst.SystemName</span></div></div>
    <div class="pt-right">
        <span id="offlineBadge" class="badge bg-warning d-none"></span>
        <a class="pt-bell" asp-controller="Notices" asp-action="Board" aria-label="Notices"><i class="bi bi-bell"></i>@if (bell > 0) { <span class="n">@bell</span> }</a>
        <div class="pt-user d-none d-md-block"><b>@displayName</b><span>@emailDisplay</span></div>
        <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" class="m-0"><button class="pt-out" type="submit">Sign out</button></form>
    </div>
</header>
<aside class="pt-side" aria-label="Main menu">
    <div class="pt-side-header d-flex align-items-center gap-10 px-3 py-3" style="border-bottom:1px solid rgba(255,255,255,.08);">
        <div class="pt-side-logo" style="width:34px;height:34px;border-radius:8px;background:var(--accent);color:#fff;display:grid;place-items:center;font-weight:700;font-size:16px;">
            @inst.Name.Substring(0,1)
        </div>
        <div class="pt-side-brand"><div style="font-size:14px;font-weight:700;color:#fff;line-height:1.1;">@inst.Name</div><div style="font-size:11px;color:#9FB1CC;opacity:.9;">@inst.SystemName</div></div>
    </div>

    <!-- Search -->
    <div class="pt-side-search px-3 py-2">
        <div class="d-flex align-items-center">
            <i class="bi bi-search text-muted" style="font-size:13px;"></i>
            <input type="text" id="sbSearch" class="form-control sidebar-search" placeholder="Search menu..." style="background:rgba(255,255,255,.08);border:none;color:#fff;font-size:13px;padding-left:6px;" />
        </div>
    </div>

    @if (student)
    {
        <div class="grp"><span class="nav-text">Dashboard</span></div>
        <a class="@A("Student", "Index", "Query", "MyQr", "Card", "UpdatePhone") sb-link asp-controller="Student" asp-action="Index" title="Dashboard"><i class="bi bi-speedometer2"></i> <span class="nav-text">Dashboard</span></a>
        <div class="grp"><span class="nav-text">Classes</span></div>
        <a class="@A("Student", "Index", "Query", "MyQr", "Card", "UpdatePhone") sb-link asp-controller="Student" asp-action="Index" title="My Timetable"><i class="bi bi-calendar3-week"></i> <span class="nav-text">My Timetable</span></a>
        <a class="@A("Student", "Report") sb-link asp-controller="Student" asp-action="Report" title="Attendance Report"><i class="bi bi-file-earmark-pdf"></i> <span class="nav-text">Attendance Report</span></a>
        <div class="grp"><span class="nav-text">Exams</span></div>
        <a class="@A("Student", "Exams") sb-link asp-controller="Student" asp-action="Exams" title="My Exams"><i class="bi bi-file-earmark-text"></i> <span class="nav-text">My Exams &amp; Results</span></a>
        <a class="@A("Student", "HallTicket") sb-link asp-controller="Student" asp-action="HallTicket" title="Hall Ticket"><i class="bi bi-ticket-perforated"></i> <span class="nav-text">Hall Ticket</span></a>
        <a class="@A("Notices", "Board") sb-link asp-controller="Notices" asp-action="Board" title="Notices"><i class="bi bi-megaphone"></i> <span class="nav-text">Notices</span></a>
        <a class="@A("Account", "ChangePassword") sb-link asp-controller="Account" asp-action="ChangePassword" title="Change Password"><i class="bi bi-key"></i> <span class="nav-text">Change Password</span></a>
    }
    @if (parent)
    {
        <a class="@A("Parent") sb-link asp-controller="Parent" asp-action="Index" title="Parent Portal"><i class="bi bi-people-fill"></i> <span class="nav-text">Parent Portal</span></a>
        <a class="@A("Account", "ChangePassword") sb-link asp-controller="Account" asp-action="ChangePassword" title="Change Password"><i class="bi bi-key"></i> <span class="nav-text">Change Password</span></a>
    }
    @if (staff)
    {
        <div class="grp"><span class="nav-text">Dashboard</span></div>
        <a class="@A("Dashboard") sb-link asp-controller="Dashboard" asp-action="Index" title="Dashboard"><i class="bi bi-speedometer2"></i> <span class="nav-text">Dashboard</span></a>
        <div class="grp"><span class="nav-text">Classes</span></div>
        <a class="@A("Attendance", todayActions) sb-link asp-controller="Attendance" asp-action="Index" title="Today's Classes"><i class="bi bi-check2-square"></i> <span class="nav-text">Today's Classes</span></a>
        <a class="@A("Timetable") sb-link asp-controller="Timetable" asp-action="Index" title="Timetable"><i class="bi bi-calendar3-week"></i> <span class="nav-text">Timetable</span></a>
        @if (admin || hod) { <a class="@A("Attendance", "Corrections") sb-link asp-controller="Attendance" asp-action="Corrections" title="Corrections"><i class="bi bi-pencil-square"></i> <span class="nav-text">Corrections</span></a> }
        @if (User.IsInRole("HOD")) { <a class="@A("Dashboard", "MyClasses") sb-link asp-controller="Dashboard" asp-action="MyClasses" title="My Classes"><i class="bi bi-person-badge"></i> <span class="nav-text">My Classes</span></a> }
        <a class="@A("Queries") sb-link asp-controller="Queries" asp-action="Index" title="Student Queries"><i class="bi bi-chat-square-text"></i> <span class="nav-text">Student Queries</span></a>
        <div class="grp"><span class="nav-text">Exams</span></div>
        <a class="@A("Exam", "Index") sb-link asp-controller="Exam" asp-action="Index" title="Exams"><i class="bi bi-file-earmark-text"></i> <span class="nav-text">Exams</span></a>
        @if (!User.IsInRole("Student"))
        {
            @if (User.IsInRole("Admin") || User.IsInRole("HOD")) { <a class="@A("Exam", "LockQueries") sb-link asp-controller="Exam" asp-action="LockQueries" title="Modification Queries"><i class="bi bi-unlock"></i> <span class="nav-text">Modification Queries</span></a> }
            else { <a class="@A("Exam", "MyQueries") sb-link asp-controller="Exam" asp-action="MyQueries" title="My Modification Queries"><i class="bi bi-arrow-repeat"></i> <span class="nav-text">My Modification Queries</span></a> }
        }
        <a class="@A("Exam", "MyResults") sb-link asp-controller="Exam" asp-action="MyResults" title="My Results"><i class="bi bi-file-earmark-text"></i> <span class="nav-text">My Results</span></a>
        <div class="grp"><span class="nav-text">Exams Invigilation</span></div>
        <a class="@A("Dashboard", "InvigilationDuties") sb-link asp-controller="Dashboard" asp-action="InvigilationDuties" title="Invigilation Duties"><i class="bi bi-shield-exclamation"></i> <span class="nav-text">Invigilation Duties</span></a>
        <div class="grp"><span class="nav-text">Reports</span></div>
        <a class="@A("Reports") sb-link asp-controller="Reports" asp-action="Index" title="Reports"><i class="bi bi-file-earmark-bar-graph"></i> <span class="nav-text">Reports</span></a>
        <a class="@A("Analytics") sb-link asp-controller="Analytics" asp-action="Index" title="Attendance Summary"><i class="bi bi-table"></i> <span class="nav-text">Attendance Summary</span></a>
        <a class="@A("Notices", "Board") sb-link asp-controller="Notices" asp-action="Board" title="Notices"><i class="bi bi-megaphone"></i> <span class="nav-text">Notices</span></a>
    }
    @if (admin || hod)
    {
        <div class="grp"><span class="nav-text">Academic Data</span></div>
        <a class="@A("Students") sb-link asp-controller="Students" asp-action="Index" title="Students"><i class="bi bi-mortarboard"></i> <span class="nav-text">Students</span></a>
        <a class="@A("Faculty") sb-link asp-controller="Faculty" asp-action="Index" title="Faculty"><i class="bi bi-person-workspace"></i> <span class="nav-text">Faculty</span></a>
        <a class="@A("FacultySubject") sb-link asp-controller="FacultySubject" asp-action="Index" title="Faculty - Subject"><i class="bi bi-diagram-3"></i> <span class="nav-text">Faculty - Subject</span></a>
        <a class="@A("Subjects") sb-link asp-controller="Subjects" asp-action="Index" title="Subjects"><i class="bi bi-book"></i> <span class="nav-text">Subjects</span></a>
        <a class="@A("Notices", "Index", "Create", "Edit", "Save", "Delete") sb-link asp-controller="Notices" asp-action="Index" title="Manage Notices"><i class="bi bi-send"></i> <span class="nav-text">Manage Notices</span></a>
    }
    @if (admin)
    {
        <div class="grp"><span class="nav-text">Infrastructure</span></div>
        <a class="@A("Branches") sb-link asp-controller="Branches" asp-action="Index" title="Branches"><i class="bi bi-building"></i> <span class="nav-text">Branches</span></a>
        <a class="@A("Sections") sb-link asp-controller="Sections" asp-action="Index" title="Sections"><i class="bi bi-grid-3x3-gap"></i> <span class="nav-text">Sections</span></a>
        <a class="@A("Holidays") sb-link asp-controller="Holidays" asp-action="Index" title="Holidays"><i class="bi bi-calendar-event"></i> <span class="nav-text">Holidays</span></a>
    }
    @if (admin || hod)
    {
        <div class="grp"><span class="nav-text">System</span></div>
        <a class="@A("Audit") sb-link asp-controller="Audit" asp-action="Index" title="Audit Log"><i class="bi bi-shield-check"></i> <span class="nav-text">Audit Log</span></a>
    }
    @if (admin)
    {
        <div class="grp"><span class="nav-text">System Admin</span></div>
        <a class="@A("Backup") sb-link asp-controller="Backup" asp-action="Index" title="Backup and Export"><i class="bi bi-database-down"></i> <span class="nav-text">Backup and Export</span></a>
        <a class="@A("Settings", "Index") sb-link asp-controller="Settings" asp-action="Index" title="Settings"><i class="bi bi-gear"></i> <span class="nav-text">Settings</span></a>
        <a class="@A("Settings", "Notifications") sb-link asp-controller="Settings" asp-action="Notifications" title="Notification Log"><i class="bi bi-bell-fill"></i> <span class="nav-text">Notification Log</span></a>
    }

    <!-- Collapse Toggle -->
    <div class="pt-side-divider"></div>
    <button id="sbCollapse" class="pt-side-collapse" title="Collapse sidebar"><i class="bi bi-chevron-left"></i></button>

    <!-- User Profile Section -->
    <div class="pt-side-user px-3 py-3" style="border-top:1px solid rgba(255,255,255,.08);">
        <div class="d-flex align-items-center gap-10">
            <div class="avatar" style="width:40px;height:40px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;font-weight:700;font-size:14px;">
                @rawName.Substring(0,1).ToUpper()
            </div>
            <div class="flex-1">
                <div style="font-size:14px;font-weight:600;color:#fff;line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@rawName</div>
                <div style="font-size:11.5px;color:#9FB1CC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@roleText</div>
            </div>
        </div>
        <div class="pt-side-user-actions mt-2">
            <a class="btn btn-outline-primary btn-sm w-100" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-1"></i>Change Password</a>
            <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" class="m-0"><button class="btn btn-outline-danger btn-sm w-100 mt-1" type="submit"><i class="bi bi-box-arrow-right me-1"></i>Sign out</button></form>
        </div>
    </div>
</aside>
<div class="ax-backdrop"></div>
<div class="pt-main">
    <div class="pt-ctx">
        <div class="crumb"><a href="/">Home</a> / <b>@ViewData["Title"]</b></div>
        <div class="info"><span>Academic Year @year.Name</span><span>@DateTime.Now.ToString("dddd, dd MMM yyyy")</span></div>
    </div>
    <main class="pt-content" id="main">
        @if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show" role="status">@ok<button class="btn-close" data-bs-dismiss="alert" type="button" aria-label="Close"></button></div> }
        @if (TempData["Error"] is string er) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@er<button class="btn-close" data-bs-dismiss="alert" type="button" aria-label="Close"></button></div> }
        @if (TempData["TempPassword"] is string tp) { <div class="alert alert-warning alert-dismissible fade show">@tp<button class="btn-close" data-bs-dismiss="alert" type="button" aria-label="Close"></button></div> }
        @RenderBody()
    </main>
    <footer class="pt-footer">&copy; @DateTime.Now.Year @inst.Name. All rights reserved.</footer>
</div>
<nav class="pt-tabbar" aria-label="Quick navigation">
    @if (student)
    {
        <a class="@A("Student", "Index", "Query", "MyQr", "Card", "UpdatePhone")" asp-controller="Student" asp-action="Index"><i class="bi bi-house"></i>Home</a>
        <a class="@A("Student", "Exams")" asp-controller="Student" asp-action="Exams"><i class="bi bi-file-earmark-text"></i>Exams</a>
        <a class="@A("Notices", "Board")" asp-controller="Notices" asp-action="Board"><i class="bi bi-megaphone"></i>Notices</a>
        <a class="@A("Student", "Report")" asp-controller="Student" asp-action="Report"><i class="bi bi-file-earmark-pdf"></i>Report</a>
    }
    else if (parent)
    {
        <a class="@A("Parent")" asp-controller="Parent" asp-action="Index"><i class="bi bi-house"></i>Home</a>
        <a class="@A("Parent")" asp-controller="Parent" asp-action="Index"><i class="bi bi-people-fill"></i>Ward</a>
    }
    else
    {
        <a class="@A("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-house"></i>Home</a>
        <a class="@A("Attendance", todayActions)" asp-controller="Attendance" asp-action="Index"><i class="bi bi-check2-square"></i>Classes</a>
        <a class="@A("Exam", "Index")" asp-controller="Exam" asp-action="Index"><i class="bi bi-file-earmark-text"></i>Exams</a>
    }
    <a href="#" id="tabMenu"><i class="bi bi-list"></i>Menu</a>
</nav>
<div class="toast-area" id="toastArea" aria-live="polite"></div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src='https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js'></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/offline-sync.js" asp-append-version="true"></script>
<script src="~/js/realtime.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
