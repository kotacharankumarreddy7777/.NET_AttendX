@model StudentFormViewModel
@{ ViewData["Title"] = Model.Id == null ? "New student" : "Edit student"; }
<div class="ax-card" style="max-width:860px"><div class="card-h">@ViewData["Title"] @if (!string.IsNullOrEmpty(Model.StudentCode)) { <code>@Model.StudentCode</code> }</div><div class="card-b">
<form method="post" enctype="multipart/form-data" data-once>
    <div asp-validation-summary="All" class="text-danger small"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="BranchId" class="form-label">Branch</label><select asp-for="BranchId" asp-items="Model.Branches" class="form-select"><option value="0">Select branch</option></select></div>
        <div class="col-md-4"><label asp-for="SectionId" class="form-label">Section</label><select asp-for="SectionId" asp-items="Model.Sections" class="form-select"><option value="0">Select section</option></select></div>
        <div class="col-md-4"><label asp-for="Semester" class="form-label"></label><input asp-for="Semester" type="number" min="1" max="8" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Year (automatic)</label><div class="form-control bg-body-secondary" id="yearView">-</div></div>
        <div class="col-md-4"><label asp-for="JoiningDate" class="form-label"></label><input asp-for="JoiningDate" type="date" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">Photo (jpg / png / webp)</label><input asp-for="Photo" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            <div class="mt-2"><button type="button" id="camBtn" class="btn btn-sm btn-outline-primary"><i class="bi bi-camera"></i> Use webcam</button> <button type="button" id="snapBtn" class="btn btn-sm btn-ax d-none">Capture</button></div>
            <input type="hidden" asp-for="WebcamPhoto" /></div>
        <div class="col-md-6"><video id="camVideo" class="d-none rounded" width="240" autoplay playsinline></video>
            @if (!string.IsNullOrEmpty(Model.ExistingPhoto)) { <img id="photoPreview" class="rounded" width="120" src="/@Model.ExistingPhoto" alt="" /> } else { <img id="photoPreview" class="rounded d-none" width="120" alt="" /> }</div>
    </div>
    @if (Model.Id != null) { <div class="alert alert-info mt-3 mb-0 small">If branch, section or semester changes, a new Student ID and a new signed QR are issued automatically (history is kept). The old QR card stops working.</div> }
    <div class="mt-3"><button class="btn btn-ax" type="submit">Save student</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form></div></div>
@section Scripts { <script src="~/js/students.js" asp-append-version="true"></script> }
