@model MappingFormViewModel
@{ ViewData["Title"] = "Assign subject"; }
<div class="ax-card" style="max-width:700px"><div class="card-h">Assign faculty to subject &amp; section</div><div class="card-b">
<form method="post" data-once>
    <div asp-validation-summary="All" class="text-danger small"></div>
    <div class="row g-3">
        <div class="col-12"><label asp-for="FacultyId" class="form-label">Faculty</label><select asp-for="FacultyId" asp-items="Model.Faculty" class="form-select"><option value="0">Select faculty</option></select></div>
        <div class="col-md-6"><label asp-for="BranchId" class="form-label">Branch</label><select asp-for="BranchId" asp-items="Model.Branches" class="form-select"><option value="0">Select branch</option></select></div>
        <div class="col-md-6"><label asp-for="Semester" class="form-label"></label><input asp-for="Semester" type="number" min="1" max="8" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="SectionId" class="form-label">Section</label><select asp-for="SectionId" asp-items="Model.Sections" class="form-select"><option value="0">Select section</option></select></div>
        <div class="col-md-6"><label asp-for="SubjectId" class="form-label">Subject</label><select asp-for="SubjectId" asp-items="Model.Subjects" class="form-select"><option value="0">Select subject</option></select></div>
    </div>
    <div class="mt-3"><button class="btn btn-ax" type="submit">Assign</button> <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form></div></div>
@section Scripts { <script src="~/js/timetable.js" asp-append-version="true"></script> }
