@model List<Subject>
@{ ViewData["Title"] = "Subjects"; bool locked = ViewBag.Locked; int? bid = ViewBag.BranchId; int? sem = ViewBag.Semester;
}
<div class="ax-card mb-3">
    <div class="card-h d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="page-title">Subjects</h1>
            <div class="text-muted small">@Model.Count subjects across @((List<SelectListItem>)ViewBag.Branches).Count branches</div>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin")) { <a class="btn btn-ax" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New subject</a> <a class="btn btn-outline-secondary" asp-action="Import"><i class="bi bi-upload me-1"></i>Import CSV</a> }
        </div>
    </div>
    <div class="card-b">
        <form method="get" class="mb-0"><div class="row g-2">
            <div class="col-md-3 col-lg-3"><select name="branchId" class="form-select" disabled="@locked"><option value="">All branches</option>@foreach (var b in (List<SelectListItem>)ViewBag.Branches) { <option value="@b.Value" selected="@(b.Value == bid?.ToString())">@b.Text</option> }</select>@if (locked) { <input type="hidden" name="branchId" value="@bid" /> }</div>
            <div class="col-md-2 col-lg-2"><select name="semester" class="form-select"><option value="">All</option>@for (int i = 1; i <= 8; i++) { <option value="@i" selected="@(sem == i)">@i</option> }</select></div>
            <div class="col-md-3 col-lg-4"><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name / code" /></div></div>
            <div class="col-md-2 col-lg-2 d-flex gap-2"><button class="btn btn-outline-primary w-100" type="submit">Filter</button><a class="btn btn-outline-secondary w-100" asp-action="Index">Clear</a></div>
        </div></form>
    </div>
</div>

<div class="ax-card mb-3"><div class="card-b">
    @if (!Model.Any()) {
        <partial name="_EmptyState" model='new EmptyStateModel("no_results", "No subjects found", "Try changing your search or filters.")' />
    } else {
    <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th style="width:120px">Code</th><th>Subject Name</th><th>Branch</th><th>Sem</th><th style="width:70px">Credits</th><th style="width:90px">Status</th><th style="width:110px"></th></tr></thead><tbody>
    @foreach (var s in Model.OrderBy(s => s.Branch!.Code).ThenBy(s => s.Semester).ThenBy(s => s.SubjectCode))
    {
        <tr>
            <td><code>@s.SubjectCode</code></td>
            <td>@s.SubjectName</td>
            <td><b>@s.Branch!.Code</b></td>
            <td>@s.Semester</td>
            <td>@s.Credits</td>
            <td>@if (s.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td>
            <td class="text-end text-nowrap">
                @if (User.IsInRole("Admin")) {
                    <div class="btn-group btn-group-sm">
                        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                        <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown"></button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <form asp-action="Toggle" asp-route-id="@s.Id" method="post" class="d-inline" data-confirm="@(s.IsActive ? "Deactivate this subject?" : "Activate this subject?")"><button class="dropdown-item text-@(s.IsActive ? "danger" : "success")" type="submit">@(s.IsActive ? "Deactivate" : "Activate")</button></form>
                        </div>
                    </div>
                }
            </td>
        </tr>
    }
    </tbody></table></div>
    }
</div></div>